# chezmoi ignore rules. Templated by OS — paths listed under a block are
# excluded when that OS condition is true.
#
# Paths are relative to $HOME (target paths), not source paths.
# Pattern syntax is gitignore-style.

# ── Local secrets — never tracked/committed ───────────────────────
.config/fish/conf.d/secrets.fish

# ── Tool-managed / machine-local — never tracked ──────────────────
.config/tmux/plugins        # installed by TPM, not part of the dotfiles
.config/nvim/.claude        # Claude Code local settings

# ── Generated by matugen — never managed by chezmoi ──────────────
# tmux/starship/kitty themes are now hand-authored Graphite (since 2026-07)
# and ARE tracked in chezmoi. Only these remain matugen-generated:
.config/tmux/matugen.conf        # no longer generated (tmux uses graphite.conf)
.config/nvim/lua/matugen.lua     # nvim uses One Dark Pro; this is dead code

# ── Linux-only (Wayland/X11 stack) — skip on macOS ─────────────────
{{- if ne .chezmoi.os "linux" }}
.config/hypr
.config/niri
.config/noctalia
.config/albert
{{- end }}

# ── macOS-only — skip on Linux ─────────────────────────────────────
{{- if ne .chezmoi.os "darwin" }}
# Add macOS-specific paths here as you create them, e.g.:
# .config/karabiner
# Library/Application Support/...
# Brewfile
{{- end }}
